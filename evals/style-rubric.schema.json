{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GCP Architecture Diagram Style Rubric Result",
  "type": "object",
  "properties": {
    "overall_pass": {
      "type": "boolean",
      "description": "True if output meets all mandatory GCP Architecture Center publication standards"
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Overall percentage score (0-100)"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "category": { "type": "string", "enum": ["outcome", "process", "style", "efficiency"] },
          "pass": { "type": "boolean" },
          "notes": { "type": "string" },
          "evidence": { "type": "string" }
        },
        "required": ["id", "category", "pass", "notes", "evidence"],
        "additionalProperties": false
      }
    }
  },
  "required": ["overall_pass", "score", "checks"],
  "additionalProperties": false
}
